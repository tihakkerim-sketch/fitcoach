{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "outDir": "dist-electron",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    "paths": {
      "@db/*": ["./db/*"],
      "@shared/*": ["./src/types/*"]
    }
  },
  "include": ["electron", "db", "src/types"],
  "exclude": ["**/*.test.ts", "**/*.spec.ts"]
}
